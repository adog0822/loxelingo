# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# item generation: the virtualenv and the bulky intermediates. out/candidates.jsonl,
# out/rejected.jsonl and out/funnel.json are the deliverables and stay tracked.
scripts/content/.venv/
scripts/content/generate/out/seeds.jsonl
scripts/content/generate/out/lexicon.json
scripts/content/generate/out/raw_candidates.jsonl
scripts/content/generate/out/raw_round*.jsonl
scripts/content/generate/out/*.round1.json
scripts/content/generate/out/*.round1.jsonl
scripts/content/generate/out/adjudication.jsonl
scripts/content/generate/__pycache__/
